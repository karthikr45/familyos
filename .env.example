# ============================================================================
# FamilyOS — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ============================================================================

# ---- Node ----
NODE_ENV=development

# ---- Database (PostgreSQL) ----
# DATABASE_URL goes through the connection pooler (e.g. PgBouncer / Supabase).
# DIRECT_URL is a direct connection used by Prisma Migrate.
DATABASE_URL="postgresql://familyos:familyos@localhost:5432/familyos?schema=public"
DIRECT_URL="postgresql://familyos:familyos@localhost:5432/familyos?schema=public"

# ---- Anthropic Claude ----
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ---- Weather (weatherapi.com) ----
WEATHER_API_KEY="your-weatherapi-com-key"

# ---- Auth / JWT ----
JWT_SECRET="change-me-access-token-secret"
JWT_REFRESH_SECRET="change-me-refresh-token-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ---- Redis (cache + BullMQ queues) ----
REDIS_URL="redis://localhost:6379"

# ---- AWS S3 (file storage) ----
AWS_S3_BUCKET="familyos-uploads"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="ap-south-1"

# ---- Firebase Admin (push notifications) ----
FIREBASE_PROJECT_ID="familyos-app"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIxxxx\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@familyos-app.iam.gserviceaccount.com"

# ---- Razorpay (payments) ----
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"

# ---- API server ----
API_PORT=3001
API_HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

# ---- Web (Next.js) — values prefixed NEXT_PUBLIC_ are exposed to the browser ----
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_FIREBASE_CONFIG='{"apiKey":"","authDomain":"","projectId":"","storageBucket":"","messagingSenderId":"","appId":""}'

# ---- Mobile (Expo) — values prefixed EXPO_PUBLIC_ are exposed to the app ----
EXPO_PUBLIC_API_URL="http://localhost:3001"
